<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Write Google TV / Android TV home-screen recommendation channels -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"/>
    <!-- Voice search: record audio for on-device speech recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- In-app update: install the downloaded release APK over this app.
         Many TV boxes have no browser, so opening the download URL is a dead
         end there — the app downloads and hands the APK to the installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Runs on both Android TV / Google TV (leanback, no touchscreen) AND
         touch phones/tablets. Nothing is required, so the app installs on every
         form factor: leanback-only TVs, and phones that lack a leanback UI. -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <!-- Mic is optional: TVs without one still install (voice button hides itself) -->
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- allowBackup keeps SharedPreferences (watchlist, watch progress, prefs)
         in Google's device backup, so a reinstall/new TV restores them. -->
    <application
        android:label="Kartoonia"
        android:allowBackup="true"
        android:name="${applicationName}"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:banner="@drawable/banner"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Show on the Android TV / Google TV home row -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- Deep links from home-screen recommendation programs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="kartoonia"/>
            </intent-filter>
        </activity>
        <!-- Exposes the downloaded update APK (app cache dir) to the system
             package installer via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller ON (Flutter's Android default). v2.2.1 disabled it (Skia)
             as a "low-end perf toggle", but on the real TV box that turned out
             to CORRUPT all video playback: every source (Stardima, Arabic
             Toons, WCOFlix) rendered as shifting solid colors with audio fine,
             because Skia's GLES path mangled the media_kit video texture the
             compositor draws — downstream of decode, so no decoder change
             helped and the desktop (non-Flutter) player was unaffected.
             Restoring Impeller (the pre-Everything-mode state, when playback
             worked) fixes it. Do NOT re-disable without testing video on the
             actual device. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Discover the system speech recognizer on Android 11+ (package visibility) -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Resolve the system voice-input dialog (RecognizerIntent) used for voice search -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
        <!-- Open the GitHub release / APK download in a browser (in-app update prompt) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
